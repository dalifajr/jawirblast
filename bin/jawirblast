#!/usr/bin/env bash
# ==============================================================================
# JAWIRBLAST — TERMINAL CONTROL PANEL CLI
# WhatsApp High-Performance Broadcast & VPS Management Engine
# ==============================================================================
set -euo pipefail

# Path Detection
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
BIN_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
APP_DIR="$(cd "${BIN_DIR}/.." && pwd)"

# Fallback ke direktori instalasi standar jika dijalankan dari symlink
if [[ ! -f "${APP_DIR}/artisan" ]] && [[ -d "/var/www/jawirblast" ]]; then
    APP_DIR="/var/www/jawirblast"
fi

ENV_FILE="${APP_DIR}/.env"
NGINX_CONF="/etc/nginx/sites-available/jawirblast"
PHP_FPM_SERVICE="$(systemctl list-units --type=service --state=running 2>/dev/null | grep -Eo 'php[0-9.]+-fpm' | head -n 1 || echo 'php-fpm')"

# Warna & Tema Terminal (Inspirasi _theme.sh)
THM_NC='\033[0m'
THM_BORDER='\033[38;5;45m'
THM_TITLE='\033[1;97m'
THM_ACCENT='\033[1;96m'
THM_KEY='\033[1;93m'
THM_VAL='\033[1;37m'
THM_OK='\033[1;32m'
THM_BAD='\033[1;31m'
THM_MUTED='\033[38;5;250m'
THM_BADGE='\033[1;35m'
THM_WARN='\033[1;33m'

# Helpers
read_env_val() {
    local key="$1"
    local default_val="${2:-}"
    if [[ -f "${ENV_FILE}" ]]; then
        local line
        line="$(grep -E "^${key}=" "${ENV_FILE}" | tail -n 1 || true)"
        if [[ -n "${line}" ]]; then
            local val="${line#*=}"
            val="${val%\"}"
            val="${val#\"}"
            val="${val%\'}"
            val="${val#\'}"
            echo "${val}"
            return
        fi
    fi
    echo "${default_val}"
}

set_env_val() {
    local key="$1"
    local val="$2"
    if [[ ! -f "${ENV_FILE}" ]]; then
        touch "${ENV_FILE}"
    fi
    if grep -qE "^${key}=" "${ENV_FILE}"; then
        sed -i "s|^${key}=.*|${key}=\"${val}\"|" "${ENV_FILE}"
    else
        echo "${key}=\"${val}\"" >> "${ENV_FILE}"
    fi
}

check_root() {
    if [[ "$(id -u)" -ne 0 ]]; then
        echo -e "${THM_BAD}[!] Perintah ini memerlukan hak akses root (sudo).${THM_NC}" >&2
        exit 1
    fi
}

get_service_status() {
    local svc="$1"
    if systemctl is-active --quiet "${svc}" 2>/dev/null; then
        echo -e "${THM_OK}ACTIVE${THM_NC}"
    else
        echo -e "${THM_BAD}INACTIVE${THM_NC}"
    fi
}

# Header Banner
show_banner() {
    clear
    local host_time
    host_time="$(date '+%Y-%m-%d %H:%M:%S')"
    local app_url
    app_url="$(read_env_val 'APP_URL' 'http://localhost')"

    local status_nginx status_php status_mysql status_wa status_worker
    status_nginx="$(get_service_status nginx)"
    status_php="$(get_service_status "${PHP_FPM_SERVICE}")"
    status_mysql="$(get_service_status mysql)"
    status_wa="$(get_service_status jawirblast-wa)"
    status_worker="$(get_service_status jawirblast-worker)"

    echo -e "${THM_BORDER}+====================================================================+${THM_NC}"
    echo -e "${THM_BORDER}|${THM_NC}                   ${THM_TITLE}JAWIRBLAST — CONTROL PANEL VPS${THM_NC}                   ${THM_BORDER}|${THM_NC}"
    echo -e "${THM_BORDER}+====================================================================+${THM_NC}"
    printf "${THM_BORDER}|${THM_NC} ${THM_MUTED}%-18s${THM_NC} : ${THM_VAL}%-45s${THM_NC} ${THM_BORDER}|${THM_NC}\n" "Waktu Server" "${host_time}"
    printf "${THM_BORDER}|${THM_NC} ${THM_MUTED}%-18s${THM_NC} : ${THM_ACCENT}%-45s${THM_NC} ${THM_BORDER}|${THM_NC}\n" "Domain / URL" "${app_url}"
    echo -e "${THM_BORDER}+--------------------------------------------------------------------+${THM_NC}"
    printf "${THM_BORDER}|${THM_NC} ${THM_KEY}%-22s${THM_NC} : %-51b ${THM_BORDER}|${THM_NC}\n" "Nginx Web Server" "${status_nginx}"
    printf "${THM_BORDER}|${THM_NC} ${THM_KEY}%-22s${THM_NC} : %-51b ${THM_BORDER}|${THM_NC}\n" "PHP-FPM Runtime" "${status_php}"
    printf "${THM_BORDER}|${THM_NC} ${THM_KEY}%-22s${THM_NC} : %-51b ${THM_BORDER}|${THM_NC}\n" "MySQL Database" "${status_mysql}"
    printf "${THM_BORDER}|${THM_NC} ${THM_KEY}%-22s${THM_NC} : %-51b ${THM_BORDER}|${THM_NC}\n" "Baileys WhatsApp" "${status_wa}"
    printf "${THM_BORDER}|${THM_NC} ${THM_KEY}%-22s${THM_NC} : %-51b ${THM_BORDER}|${THM_NC}\n" "Queue Broadcast" "${status_worker}"
    echo -e "${THM_BORDER}+====================================================================+${THM_NC}"
}

# Menu Functions
cmd_status() {
    show_banner
    echo -e "\n${THM_TITLE}Rincian Port & Proses:${THM_NC}"
    echo -e "  - Baileys WhatsApp Port  : $(ss -tulpn 2>/dev/null | grep ':3000 ' || echo 'Tidak aktif pada port 3000')"
    echo -e "  - MySQL Database Port    : $(ss -tulpn 2>/dev/null | grep ':3306 ' || echo 'Tidak aktif pada port 3306')"
    echo -e "  - Web HTTP / HTTPS Port  : $(ss -tulpn 2>/dev/null | grep -E ':(80|443) ' || echo 'Tidak aktif pada port 80/443')"
    echo ""
}

cmd_start() {
    check_root
    echo -e "${THM_ACCENT}[*] Menjalankan seluruh service JAWIRBLAST...${THM_NC}"
    systemctl start mysql || true
    systemctl start "${PHP_FPM_SERVICE}" || true
    systemctl start nginx || true
    systemctl start jawirblast-wa || true
    systemctl start jawirblast-worker || true
    echo -e "${THM_OK}[✓] Seluruh service berhasil dijalankan.${THM_NC}"
}

cmd_stop() {
    check_root
    echo -e "${THM_WARN}[*] Menghentikan service JAWIRBLAST...${THM_NC}"
    systemctl stop jawirblast-worker || true
    systemctl stop jawirblast-wa || true
    systemctl stop nginx || true
    echo -e "${THM_OK}[✓] Service aplikasi dan web server berhasil dihentikan.${THM_NC}"
}

cmd_restart() {
    check_root
    echo -e "${THM_ACCENT}[*] Memulai ulang (restart) seluruh service JAWIRBLAST...${THM_NC}"
    systemctl restart mysql || true
    systemctl restart "${PHP_FPM_SERVICE}" || true
    systemctl restart nginx || true
    systemctl restart jawirblast-wa || true
    systemctl restart jawirblast-worker || true
    echo -e "${THM_OK}[✓] Seluruh service berhasil di-restart.${THM_NC}"
}

cmd_setup_cloudflare_ssl() {
    check_root
    echo -e "${THM_BORDER}+====================================================================+${THM_NC}"
    echo -e "${THM_BORDER}|${THM_NC}      ${THM_TITLE}PASANG CLOUDFLARE ORIGIN CERTIFICATE (PROXIED / 15 TAHUN)${THM_NC}      ${THM_BORDER}|${THM_NC}"
    echo -e "${THM_BORDER}+====================================================================+${THM_NC}"
    echo -e "${THM_VAL}Khusus untuk domain yang menggunakan proxy Cloudflare (Awan Oranye).${THM_NC}"
    echo -e "${THM_MUTED}Masa aktif sertifikat 15 tahun dan mendukung mode Full (Strict).${THM_NC}\n"

    local current_domain
    current_domain="$(read_env_val 'APP_URL' 'http://localhost' | sed -E 's|https?://||; s|:[0-9]+||; s|/.*||')"
    read -rp "Masukkan nama domain (default: ${current_domain}): " input_domain
    local domain="${input_domain:-${current_domain}}"
    domain="$(echo "${domain}" | tr -d ' ')"

    if [[ -z "${domain}" || "${domain}" == "localhost" ]]; then
        echo -e "${THM_BAD}[!] Nama domain tidak valid.${THM_NC}"
        return
    fi

    local ssl_dir="/etc/ssl/jawirblast"
    mkdir -p "${ssl_dir}"

    # Pastikan port 80 dan 443 terbuka pada UFW jika aktif untuk mencegah Cloudflare Error 522
    if command -v ufw >/dev/null 2>&1; then
        if ufw status 2>/dev/null | grep -qw "active"; then
            echo -e "${THM_MUTED}[*] Memastikan port 80 dan 443 diizinkan pada UFW Firewall...${THM_NC}"
            ufw allow 80/tcp >/dev/null 2>&1 || true
            ufw allow 443/tcp >/dev/null 2>&1 || true
        fi
    fi

    echo -e "\n${THM_KEY}Langkah 1: Masukkan Cloudflare Origin Certificate${THM_NC}"
    echo -e "${THM_MUTED}(Salin dari dashboard Cloudflare. Tekan Enter setelah baris -----END CERTIFICATE----- atau ketik EOF)${THM_NC}"
    echo -e "${THM_ACCENT}Paste Origin Certificate di sini:${THM_NC}"

    local cert_data=""
    while IFS= read -r line; do
        [[ "${line}" == "EOF" ]] && break
        cert_data+="${line}"$'\n'
        [[ "${line}" =~ "-----END CERTIFICATE-----" ]] && break
    done

    if [[ ! "${cert_data}" =~ "-----BEGIN CERTIFICATE-----" ]]; then
        echo -e "${THM_BAD}[!] Format sertifikat tidak valid. Harus memuat '-----BEGIN CERTIFICATE-----'.${THM_NC}"
        return
    fi

    echo -e "\n${THM_KEY}Langkah 2: Masukkan Cloudflare Private Key${THM_NC}"
    echo -e "${THM_MUTED}(Salin dari dashboard Cloudflare. Tekan Enter setelah baris -----END PRIVATE KEY----- atau ketik EOF)${THM_NC}"
    echo -e "${THM_ACCENT}Paste Private Key di sini:${THM_NC}"

    local key_data=""
    while IFS= read -r line; do
        [[ "${line}" == "EOF" ]] && break
        key_data+="${line}"$'\n'
        [[ "${line}" =~ "-----END "(RSA |EC )?"PRIVATE KEY-----" ]] && break
    done

    if [[ ! "${key_data}" =~ "-----BEGIN "(RSA |EC )?"PRIVATE KEY-----" ]]; then
        echo -e "${THM_BAD}[!] Format private key tidak valid. Harus memuat '-----BEGIN PRIVATE KEY-----'.${THM_NC}"
        return
    fi

    # Simpan sertifikat dan kunci
    printf '%s' "${cert_data}" > "${ssl_dir}/cert.pem"
    printf '%s' "${key_data}" > "${ssl_dir}/key.pem"
    chmod 600 "${ssl_dir}/key.pem"
    chmod 644 "${ssl_dir}/cert.pem"

    echo -e "${THM_OK}[✓] File sertifikat dan private key berhasil disimpan di ${ssl_dir}.${THM_NC}"

    # Deteksi socket PHP-FPM
    local php_sock
    php_sock="$(find /run/php/ -name 'php*-fpm.sock' 2>/dev/null | head -n 1 || echo "/run/php/${PHP_FPM_SERVICE}.sock")"

    # Deteksi dukungan sintaks HTTP/2 Nginx (Nginx 1.25+ menggunakan 'http2 on;', versi lama menggunakan 'listen ... http2;')
    local ssl_listen_1="listen 443 ssl http2;"
    local ssl_listen_2="listen [::]:443 ssl http2;"
    local http2_directive=""
    local ngx_v
    ngx_v="$(nginx -v 2>&1 || true)"
    if echo "${ngx_v}" | grep -qE "nginx/([2-9]\.|1\.(2[5-9]|[3-9][0-9]))"; then
        ssl_listen_1="listen 443 ssl;"
        ssl_listen_2="listen [::]:443 ssl;"
        http2_directive="http2 on;"
    fi

    # Tulis konfigurasi Nginx modern dengan HTTP/2 dan SSL
    cat <<EOF > "${NGINX_CONF}"
server {
    listen 80;
    listen [::]:80;
    server_name ${domain};
    return 301 https://\$host\$request_uri;
}

server {
    ${ssl_listen_1}
    ${ssl_listen_2}
    ${http2_directive}
    server_name ${domain};
    root ${APP_DIR}/public;

    ssl_certificate ${ssl_dir}/cert.pem;
    ssl_certificate_key ${ssl_dir}/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";

    index index.php index.html;
    charset utf-8;

    location / {
        try_files \$uri \$uri/ /index.php?\$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    location ~ \.php$ {
        fastcgi_pass unix:${php_sock};
        fastcgi_param SCRIPT_FILENAME \$realpath_root\$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_read_timeout 300;
    }

    # Reverse proxy ke Baileys API internal
    location /wa-api/ {
        proxy_pass http://127.0.0.1:3000/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_cache_bypass \$http_upgrade;
        proxy_read_timeout 86400s;
        proxy_buffering off;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
EOF

    ln -sf "${NGINX_CONF}" /etc/nginx/sites-enabled/jawirblast
    rm -f /etc/nginx/sites-enabled/default 2>/dev/null || true

    if nginx -t; then
        systemctl reload nginx
        set_env_val "APP_URL" "https://${domain}"
        cd "${APP_DIR}" && php artisan config:clear || true

        echo -e "\n${THM_BORDER}+====================================================================+${THM_NC}"
        echo -e "${THM_OK}[✓] SSL Cloudflare Origin Certificate BERHASIL DIPASANG!${THM_NC}"
        echo -e "${THM_BORDER}+====================================================================+${THM_NC}"
        echo -e "Domain Aktif  : ${THM_ACCENT}https://${domain}${THM_NC}"
        echo -e "Panduan di Dashboard Cloudflare:"
        echo -e "  1. Menu ${THM_KEY}SSL/TLS${THM_NC} ➔ Ubah mode enkripsi ke ${THM_OK}Full (Strict)${THM_NC}."
        echo -e "  2. Menu ${THM_KEY}DNS${THM_NC} ➔ Pastikan record berstatus ${THM_WARN}Proxied (Awan Oranye)${THM_NC}."
        echo -e "${THM_BORDER}+====================================================================+${THM_NC}"
    else
        echo -e "${THM_BAD}[!] Pengujian konfigurasi Nginx gagal. Periksa kembali cert & key.${THM_NC}"
    fi
}

cmd_change_domain() {
    check_root
    echo -e "${THM_TITLE}:: PENGATURAN DOMAIN & METODE SSL ::${THM_NC}"
    echo -e "Pilih metode setup:"
    echo -e " ${THM_BADGE}[1]${THM_NC} Cloudflare Origin Certificate (Direkomendasikan untuk DNS Proxied / Awan Oranye)"
    echo -e " ${THM_BADGE}[2]${THM_NC} Otomatis Let's Encrypt via Certbot (Untuk DNS Direct / Awan Abu-abu)"
    read -rp "Pilih opsi [1-2]: " ssl_method

    if [[ "${ssl_method}" == "1" ]]; then
        cmd_setup_cloudflare_ssl
        return
    fi

    echo -e "\n${THM_TITLE}:: SETUP DOMAIN DENGAN LET'S ENCRYPT CERTBOT ::${THM_NC}"
    read -rp "Masukkan nama domain baru (contoh: blast.domainanda.com): " new_domain
    new_domain="$(echo "${new_domain}" | tr -d ' ')"

    if [[ -z "${new_domain}" ]]; then
        echo -e "${THM_BAD}[!] Nama domain tidak boleh kosong.${THM_NC}"
        return
    fi

    echo -e "${THM_ACCENT}[*] Memperbarui konfigurasi Nginx untuk domain: ${new_domain}...${THM_NC}"
    local php_sock
    php_sock="$(find /run/php/ -name 'php*-fpm.sock' 2>/dev/null | head -n 1 || echo "/run/php/${PHP_FPM_SERVICE}.sock")"

    cat <<EOF > "${NGINX_CONF}"
server {
    listen 80;
    server_name ${new_domain};
    root ${APP_DIR}/public;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";

    index index.php index.html;
    charset utf-8;

    location / {
        try_files \$uri \$uri/ /index.php?\$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    location ~ \.php$ {
        fastcgi_pass unix:${php_sock};
        fastcgi_param SCRIPT_FILENAME \$realpath_root\$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_read_timeout 300;
    }

    location /wa-api/ {
        proxy_pass http://127.0.0.1:3000/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host \$host;
        proxy_cache_bypass \$http_upgrade;
        proxy_read_timeout 86400s;
        proxy_buffering off;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
EOF
    ln -sf "${NGINX_CONF}" /etc/nginx/sites-enabled/jawirblast

    nginx -t
    systemctl reload nginx

    # Memperbarui APP_URL di .env
    set_env_val "APP_URL" "https://${new_domain}"
    cd "${APP_DIR}" && php artisan config:clear || true

    # Pasang SSL Certbot jika certbot tersedia
    read -rp "Apakah Anda ingin langsung menerbitkan SSL Let's Encrypt via Certbot? (y/n): " install_ssl
    if [[ "${install_ssl}" =~ ^[Yy]$ ]]; then
        echo -e "${THM_ACCENT}[*] Menjalankan Certbot untuk ${new_domain}...${THM_NC}"
        certbot --nginx -d "${new_domain}" --non-interactive --agree-tos --register-unsafely-without-email --redirect || {
            echo -e "${THM_WARN}[!] Certbot mengalami kendala. Pastikan A record DNS berstatus DNS Only (Awan Abu-abu).${THM_NC}"
        }
    fi

    echo -e "${THM_OK}[✓] Konfigurasi domain berhasil diperbarui ke: https://${new_domain}${THM_NC}"
}

cmd_reset_admin() {
    check_root
    echo -e "${THM_TITLE}:: RESET PASSWORD ADMIN WEBSITE ::${THM_NC}"
    read -rp "Masukkan email admin: " admin_email
    read -rp "Masukkan password baru (min 8 karakter): " admin_password

    if [[ -z "${admin_email}" || -z "${admin_password}" ]]; then
        echo -e "${THM_BAD}[!] Email dan password wajib diisi.${THM_NC}"
        return
    fi

    cd "${APP_DIR}"
    php artisan jawirblast:reset-admin "${admin_email}" "${admin_password}"
    echo -e "${THM_OK}[✓] Password admin berhasil diatur ulang.${THM_NC}"
}

cmd_turnstile() {
    check_root
    echo -e "${THM_TITLE}:: PENGATURAN CLOUDFLARE TURNSTILE ::${THM_NC}"
    echo -e "Kunci saat ini:"
    echo -e "  Site Key   : $(read_env_val 'CLOUDFLARE_TURNSTILE_SITE_KEY' '(belum diset)')"
    echo -e "  Secret Key : $(read_env_val 'CLOUDFLARE_TURNSTILE_SECRET_KEY' '(belum diset)')"
    echo ""
    read -rp "Masukkan Cloudflare Turnstile Site Key baru: " cf_site
    read -rp "Masukkan Cloudflare Turnstile Secret Key baru: " cf_secret

    if [[ -n "${cf_site}" ]]; then
        set_env_val "CLOUDFLARE_TURNSTILE_SITE_KEY" "${cf_site}"
    fi
    if [[ -n "${cf_secret}" ]]; then
        set_env_val "CLOUDFLARE_TURNSTILE_SECRET_KEY" "${cf_secret}"
    fi

    cd "${APP_DIR}" && php artisan config:clear
    echo -e "${THM_OK}[✓] Kunci Cloudflare Turnstile berhasil disimpan.${THM_NC}"
}

cmd_telegram() {
    check_root
    echo -e "${THM_TITLE}:: PENGATURAN BOT TELEGRAM & NOTIFIKASI ADMIN ::${THM_NC}"
    echo -e "Konfigurasi saat ini:"
    echo -e "  Bot Token  : $(read_env_val 'TELEGRAM_BOT_TOKEN' '(belum diset)')"
    echo -e "  Chat ID    : $(read_env_val 'TELEGRAM_ADMIN_CHAT_ID' '(belum diset)')"
    echo ""
    read -rp "Masukkan Bot Token Telegram baru: " tele_token
    read -rp "Masukkan Admin Chat ID Telegram baru: " tele_chat_id

    if [[ -n "${tele_token}" ]]; then
        # Tes konektivitas bot
        echo -e "${THM_ACCENT}[*] Memverifikasi token bot Telegram...${THM_NC}"
        local bot_info
        bot_info="$(curl -s --connect-timeout 5 "https://api.telegram.org/bot${tele_token}/getMe" || true)"
        if echo "${bot_info}" | grep -q '"ok":true'; then
            local bot_uname
            bot_uname="$(echo "${bot_info}" | grep -Eo '"username":"[^"]+"' | cut -d':' -f2 | tr -d '"')"
            echo -e "${THM_OK}[✓] Bot valid: @${bot_uname}${THM_NC}"
            set_env_val "TELEGRAM_BOT_TOKEN" "${tele_token}"
            set_env_val "TELEGRAM_BOT_USERNAME" "${bot_uname}"
        else
            echo -e "${THM_BAD}[!] Token bot Telegram tidak valid atau gagal terhubung ke Telegram API.${THM_NC}"
            read -rp "Tetap simpan token ini? (y/n): " force_save
            if [[ "${force_save}" =~ ^[Yy]$ ]]; then
                set_env_val "TELEGRAM_BOT_TOKEN" "${tele_token}"
            fi
        fi
    fi

    if [[ -n "${tele_chat_id}" ]]; then
        set_env_val "TELEGRAM_ADMIN_CHAT_ID" "${tele_chat_id}"
    fi

    cd "${APP_DIR}" && php artisan config:clear
    echo -e "${THM_OK}[✓] Konfigurasi Telegram berhasil diperbarui.${THM_NC}"
}

cmd_update_website() {
    check_root
    echo -e "${THM_TITLE}:: PEMBARUAN SISTEM JAWIRBLAST (RESILIENT GIT SYNC, MIGRATE & SEED) ::${THM_NC}"
    cd "${APP_DIR}"

    echo -e "${THM_ACCENT}[1/7] Menarik kode terbaru dari Git (Auto-Stash & Force Sync)...${THM_NC}"

    # Layer 1: Deteksi dan amankan modifikasi lokal ke git stash jika ada (mencegah abort overwrite)
    if [[ -n "$(git status --porcelain 2>/dev/null || true)" ]]; then
        echo -e "${THM_MUTED}[*] Mendeteksi perubahan lokal yang belum di-commit. Menyimpan otomatis ke git stash...${THM_NC}"
        git stash push -u -m "auto-stash-jawirblast-update-$(date +%Y%m%d%H%M%S)" 2>/dev/null || true
    fi

    # Layer 2 & 3: Ambil referensi terbaru dan sinkronkan branch secara bersih ke origin/main
    git fetch origin main --prune 2>/dev/null || git fetch origin 2>/dev/null || true
    if git reset --hard origin/main 2>/dev/null; then
        echo -e "${THM_OK}[✓] Kode aplikasi berhasil disinkronkan ke origin/main.${THM_NC}"
    elif git pull origin main --rebase 2>/dev/null; then
        echo -e "${THM_OK}[✓] Kode aplikasi berhasil diperbarui via git pull rebase.${THM_NC}"
    elif git pull origin main 2>/dev/null; then
        echo -e "${THM_OK}[✓] Kode aplikasi berhasil diperbarui via git pull.${THM_NC}"
    else
        echo -e "${THM_WARN}[!] Git sync mengalami kendala. Melanjutkan ke langkah dependensi...${THM_NC}"
    fi

    # Layer 4: Pulihkan izin eksekusi biner CLI dan artisan
    chmod +x "${APP_DIR}/bin/jawirblast" "${APP_DIR}/artisan" 2>/dev/null || true

    echo -e "${THM_ACCENT}[2/7] Memperbarui dependensi Composer...${THM_NC}"
    composer install --no-dev --optimize-autoloader --no-interaction

    echo -e "${THM_ACCENT}[3/7] Memperbarui dependensi Baileys WhatsApp Node.js...${THM_NC}"
    if [[ -d "${APP_DIR}/wa-service" ]]; then
        (cd "${APP_DIR}/wa-service" && npm install --production)
    fi

    echo -e "${THM_ACCENT}[4/7] Menjalankan migrasi database...${THM_NC}"
    php artisan migrate --force

    echo -e "${THM_ACCENT}[5/7] Menjalankan seeder akun & sinkronisasi peran pengguna (Superadmin)...${THM_NC}"
    php artisan db:seed --force

    echo -e "${THM_ACCENT}[6/7] Mengoptimalkan cache aplikasi...${THM_NC}"
    php artisan optimize:clear
    php artisan optimize

    echo -e "${THM_ACCENT}[7/7] Memulai ulang daemon WhatsApp dan Queue Worker...${THM_NC}"
    systemctl restart jawirblast-wa || true
    systemctl restart jawirblast-worker || true

    echo -e "${THM_OK}[✓] Pembaruan website JAWIRBLAST selesai dengan sukses! Akun superadmin & konfigurasi tersinkron.${THM_NC}"
}

cmd_seed_database() {
    check_root
    echo -e "${THM_TITLE}:: SINKRONISASI SEEDER BASIS DATA JAWIRBLAST ::${THM_NC}"
    cd "${APP_DIR}"
    php artisan db:seed --force
    echo -e "${THM_OK}[✓] Seeder basis data berhasil dieksekusi. Akun superadmin 'dzulfikri' dan role pengguna tersinkronisasi.${THM_NC}"
}

cmd_logs() {
    echo -e "${THM_TITLE}:: LIHAT LOG SISTEM REAL-TIME ::${THM_NC}"
    echo -e " ${THM_BADGE}[1]${THM_NC} Laravel Log (storage/logs/laravel.log)"
    echo -e " ${THM_BADGE}[2]${THM_NC} Baileys WhatsApp Daemon (jawirblast-wa)"
    echo -e " ${THM_BADGE}[3]${THM_NC} Broadcast Queue Worker (jawirblast-worker)"
    echo -e " ${THM_BADGE}[4]${THM_NC} Nginx Error Log (/var/log/nginx/error.log)"
    echo -e " ${THM_BADGE}[0]${THM_NC} Kembali"
    read -rp "Pilih log yang ingin dilihat [0-4]: " log_choice

    case "${log_choice}" in
        1)
            tail -n 100 -f "${APP_DIR}/storage/logs/laravel.log"
            ;;
        2)
            journalctl -u jawirblast-wa -f -n 100
            ;;
        3)
            journalctl -u jawirblast-worker -f -n 100
            ;;
        4)
            tail -n 100 -f /var/log/nginx/error.log
            ;;
        *)
            return
            ;;
    esac
}

cmd_backup() {
    check_root
    echo -e "${THM_TITLE}:: BACKUP BASIS DATA MYSQL ::${THM_NC}"
    local db_name db_user db_pass backup_dir backup_file
    db_name="$(read_env_val 'DB_DATABASE' 'blast')"
    db_user="$(read_env_val 'DB_USERNAME' 'root')"
    db_pass="$(read_env_val 'DB_PASSWORD' '')"
    backup_dir="${APP_DIR}/storage/backups"
    mkdir -p "${backup_dir}"

    backup_file="${backup_dir}/backup_${db_name}_$(date '+%Y%m%d_%H%M%S').sql.gz"

    echo -e "${THM_ACCENT}[*] Mengekspor basis data ${db_name}...${THM_NC}"
    if [[ -n "${db_pass}" ]]; then
        mysqldump -u "${db_user}" -p"${db_pass}" "${db_name}" | gzip > "${backup_file}"
    else
        mysqldump -u "${db_user}" "${db_name}" | gzip > "${backup_file}"
    fi

    echo -e "${THM_OK}[✓] Backup berhasil disimpan di: ${backup_file}${THM_NC}"
    echo -e "Ukuran: $(du -h "${backup_file}" | cut -f1)"
}

# Main Interactive Loop
interactive_menu() {
    while true; do
        show_banner
        echo -e " ${THM_BADGE}[01]${THM_NC} ${THM_VAL}Status & Health Check Service${THM_NC}"
        echo -e " ${THM_BADGE}[02]${THM_NC} ${THM_VAL}Start Semua Service${THM_NC}"
        echo -e " ${THM_BADGE}[03]${THM_NC} ${THM_VAL}Stop Semua Service${THM_NC}"
        echo -e " ${THM_BADGE}[04]${THM_NC} ${THM_VAL}Restart Semua Service (Reload)${THM_NC}"
        echo -e " ${THM_BADGE}[05]${THM_NC} ${THM_VAL}Ganti Domain Website (Let's Encrypt / Cloudflare)${THM_NC}"
        echo -e " ${THM_BADGE}[06]${THM_NC} ${THM_VAL}Pasang Cloudflare Origin Certificate (DNS Proxied / 15 Tahun)${THM_NC}"
        echo -e " ${THM_BADGE}[07]${THM_NC} ${THM_VAL}Reset Password Admin Website${THM_NC}"
        echo -e " ${THM_BADGE}[08]${THM_NC} ${THM_VAL}Ubah Cloudflare Turnstile Key${THM_NC}"
        echo -e " ${THM_BADGE}[09]${THM_NC} ${THM_VAL}Ubah Bot Token & Admin ID Telegram${THM_NC}"
        echo -e " ${THM_BADGE}[10]${THM_NC} ${THM_VAL}Update Website (Git Pull + Migrate + Seed + Restart)${THM_NC}"
        echo -e " ${THM_BADGE}[11]${THM_NC} ${THM_VAL}Lihat Live Log (Laravel / WhatsApp / Worker / Nginx)${THM_NC}"
        echo -e " ${THM_BADGE}[12]${THM_NC} ${THM_VAL}Backup Database MySQL${THM_NC}"
        echo -e " ${THM_BADGE}[13]${THM_NC} ${THM_VAL}Seed Database (Sinkronisasi Akun Superadmin & User)${THM_NC}"
        echo -e " ${THM_BADGE}[00]${THM_NC} ${THM_MUTED}Keluar Dari Panel${THM_NC}"
        echo -e "${THM_BORDER}+====================================================================+${THM_NC}"
        read -rp "Pilih menu [0-13]: " choice

        case "${choice}" in
            1|01) cmd_status ;;
            2|02) cmd_start ;;
            3|03) cmd_stop ;;
            4|04) cmd_restart ;;
            5|05) cmd_change_domain ;;
            6|06) cmd_setup_cloudflare_ssl ;;
            7|07) cmd_reset_admin ;;
            8|08) cmd_turnstile ;;
            9|09) cmd_telegram ;;
            10) cmd_update_website ;;
            11) cmd_logs ;;
            12) cmd_backup ;;
            13) cmd_seed_database ;;
            0|00|q|exit)
                echo -e "${THM_OK}Sampai jumpa! JAWIRBLAST Panel ditutup.${THM_NC}"
                exit 0
                ;;
            *)
                echo -e "${THM_BAD}[!] Pilihan tidak valid.${THM_NC}"
                ;;
        esac

        echo ""
        read -rp "Tekan [Enter] untuk kembali ke menu utama..." _
    done
}

# Subcommand Argument Router
if [[ $# -gt 0 ]]; then
    case "$1" in
        status) cmd_status ;;
        start) cmd_start ;;
        stop) cmd_stop ;;
        restart) cmd_restart ;;
        change-domain) cmd_change_domain ;;
        ssl-cloudflare|cf-ssl|origin-cert) cmd_setup_cloudflare_ssl ;;
        reset-admin)
            shift
            check_root
            cd "${APP_DIR}" && php artisan jawirblast:reset-admin "$@"
            ;;
        update) cmd_update_website ;;
        seed|db-seed) cmd_seed_database ;;
        logs) cmd_logs ;;
        backup) cmd_backup ;;
        *)
            echo "Penggunaan: jawirblast [status|start|stop|restart|change-domain|ssl-cloudflare|reset-admin|update|seed|logs|backup]"
            exit 1
            ;;
    esac
else
    interactive_menu
fi
